<html>
  <head><title>Búsqueda</title></head>
  <body>
    <h1>Resultados de búsqueda para: <%= q %></h1>
    <ul>
      <% if (results.length > 0) { %>
        <% results.forEach(function(t) { %>
          <li><strong><%= t.title %></strong><br/><%= t.description %></li>
        <% }); %>
      <% } else { %>
        <li>No se encontraron resultados</li>
      <% } %>
    </ul>
    <p><a href="/">Volver</a></p>
  </body>
</html>
